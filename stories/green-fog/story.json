  "scenes": [
    {
      "id": "s01",
      "text": {
        "en": "In our town, whenever the green fog rolls in, everyone has to get up on a roof. Because something lives under the ground.",
        "uz": "Bizning shaharda yashil tuman tushsa, hamma darhol tomga chiqishi shart. Chunki yer ostida nimadir yashaydi."
      },
